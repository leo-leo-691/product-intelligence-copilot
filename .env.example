# === LLM provider (gemini default | anthropic) ===
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# === Web search for gap-fill (leave blank for offline demo) ===
TAVILY_API_KEY=
SERPAPI_API_KEY=

# === Deploy / security (Render backend) ===
# Set a strong value in production; Vercel frontend sends header X-API-Key via VITE_API_KEY
API_KEY=
APP_ENV=development
# Local dev defaults below; on Render add your Vercel URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25

# === Frontend (Vercel) — set in Vercel project env, not Render ===
# VITE_API_URL=https://your-api.onrender.com
# VITE_API_KEY=<same value as API_KEY when auth is enabled>

# === Pipeline knobs ===
PDF_RASTER_MAX_PAGES=3
PDF_SPARSE_CHAR_THRESHOLD=120
GAP_FILL_MAX_CALLS=2
CRAWL_MAX_PAGES=3
CRAWL_ENABLED=true
OUTLIER_Z_THRESHOLD=2.5
TRANSLATE_ENABLED=true
KG_ENABLED=true
